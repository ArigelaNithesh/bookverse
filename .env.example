# BOOKVERSE Environment Configuration Example

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/bookverse_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=rootpassword

# H2 Standalone Fallback Database (used if MySQL is absent or in dev profile)
# DB_URL=jdbc:h2:mem:bookversedb;MODE=MySQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
# DB_USERNAME=sa
# DB_PASSWORD=

# Security & Bootstrap
ADMIN_EMAIL=admin@bookverse.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FULL_NAME=Bookverse Administrator
